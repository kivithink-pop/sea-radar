---
import { getLocaleFromUrl, useTranslations, localeNames, localeFlags, getLocalizedPath } from '../i18n/utils.js';
import '../styles/global.css';

const { url } = Astro;
const lang = getLocaleFromUrl(url);
const t = useTranslations(lang);

const currentPath = url.pathname.replace(/^\/(en|th|vi|km)/, '') || '/';
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t('site.description')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t('site.title')} - {t('site.subtitle')}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={getLocalizedPath('/', lang)} class="logo">
          <span class="logo-icon">🌏</span>
          <span class="logo-text">{t('site.title')}</span>
        </a>
        <nav class="main-nav">
          <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
          <a href={getLocalizedPath('/news', lang)}>{t('nav.news')}</a>
          <a href={getLocalizedPath('/about', lang)}>{t('nav.about')}</a>
        </nav>
        <div class="lang-switcher">
          <details>
            <summary>
              <span class="lang-flag">{localeFlags[lang]}</span>
              <span class="lang-name">{localeNames[lang]}</span>
              <span class="lang-arrow">▾</span>
            </summary>
            <ul>
              {Object.entries(localeNames).map(([code, name]) => (
                <li>
                  <a href={getLocalizedPath(currentPath, code)}>
                    <span class="lang-flag">{localeFlags[code]}</span>
                    <span>{name}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main class="site-main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-tagline">{t('site.footer')}</p>
        <p class="footer-meta">
          © 2026 Sea Radar · MIT License · <a href="https://github.com/kivithink-pop/sea-radar" target="_blank" rel="noopener">GitHub</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        background: var(--color-bg);
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(8px);
        background: rgba(255, 255, 255, 0.9);
      }
      @media (prefers-color-scheme: dark) {
        .site-header { background: rgba(15, 23, 42, 0.9); }
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        padding-bottom: 1rem;
        gap: 2rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
      }
      .logo-icon { font-size: 1.5rem; }
      .main-nav {
        display: flex;
        gap: 1.5rem;
        flex: 1;
        justify-content: center;
      }
      .main-nav a {
        color: var(--color-text-muted);
        font-weight: 500;
        padding: 0.5rem 0;
        border-bottom: 2px solid transparent;
      }
      .main-nav a:hover {
        color: var(--color-primary);
        border-bottom-color: var(--color-primary);
      }
      .lang-switcher details { position: relative; }
      .lang-switcher summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        cursor: pointer;
        background: var(--color-bg);
      }
      .lang-switcher summary::-webkit-details-marker { display: none; }
      .lang-flag { font-size: 1.1rem; }
      .lang-switcher ul {
        position: absolute;
        right: 0;
        top: 100%;
        margin-top: 0.5rem;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow-md);
        min-width: 180px;
        z-index: 10;
        list-style: none;
      }
      .lang-switcher li a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.9rem;
        color: var(--color-text);
      }
      .lang-switcher li a:hover { background: var(--color-bg-soft); }
      .site-main {
        flex: 1;
        padding: 2rem 0 4rem;
      }
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 2rem 0;
        background: var(--color-bg-soft);
        text-align: center;
        color: var(--color-text-muted);
      }
      .footer-tagline { font-style: italic; margin-bottom: 0.5rem; }
      .footer-meta { font-size: 0.875rem; }
      @media (max-width: 768px) {
        .header-inner { flex-wrap: wrap; gap: 1rem; }
        .main-nav { order: 3; width: 100%; justify-content: flex-start; gap: 1rem; }
        .lang-name, .lang-arrow { display: none; }
      }
    </style>
  </body>
</html>
